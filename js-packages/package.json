{
  "name": "unique-tests",
  "version": "1.0.0",
  "description": "Unique Chain Tests",
  "author": "",
  "license": "SEE LICENSE IN ../LICENSE",
  "homepage": "",
  "main": "",
  "private": true,
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.2",
    "@polkadot/api-base": "15.5.2",
    "@polkadot/keyring": "^13.5.3",
    "@polkadot/rpc-core": "15.5.2",
    "@polkadot/types-codec": "15.5.2",
    "@polkadot/types": "15.5.2",
    "chai-as-promised": "^7.1.1",
    "chai-like": "^1.1.1",
    "csv-writer": "^1.6.0",
    "ethers": "6.13.5",
    "solc": "^0.8.22"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/chai-like": "^1.1.3",
    "@types/chai-subset": "^1.3.6",
    "@types/node": "^20.8.10",
    "@typescript-eslint/eslint-plugin": "8.27.0",
    "@typescript-eslint/parser": "8.27.0",
    "@unique-nft/evm-abi": "workspace:*",
    "@unique-nft/opal-testnet-types": "workspace:*",
    "@unique-nft/playgrounds": "workspace:*",
    "@unique/test-utils": "workspace:*",
    "chai": "^4.5.0",
    "chai-subset": "^1.6.0",
    "eslint": "^8.53.0",
    "eslint-plugin-mocha": "^10.2.0",
    "typescript": "5.8.3"
  },
  "scripts": {
    "prepublish": "deno check",
    "ts-check": "deno check --quiet",
    "lint": "eslint --ext .ts .",
    "fix": "deno lint --fix",
    "polkadot-types-fetch-metadata": "deno --allow-env scripts/fetchMetadata.ts",
    "polkadot-types-from-defs": "deno --allow-env ./node_modules/.bin/polkadot-types-from-defs --endpoint scripts/metadata.json --input types/ --package .",
    "polkadot-types-from-chain": "deno --allow-env ./node_modules/.bin/polkadot-types-from-chain --endpoint scripts/metadata.json --output types/ --package .",
    "polkadot-types": "echo \"export default {}\" > types/lookup.ts && deno task polkadot-types-fetch-metadata && deno task polkadot-types-from-defs && deno task polkadot-types-from-defs && deno task polkadot-types-from-chain && rm types/registry.ts"
  },
  "resolutions": {
    "decode-uri-component": "^0.2.1"
  },
  "type": "module",
  "workspaces": [
    "types",
    "evm-abi",
    "playgrounds",
    "scripts",
    "test-utils",
    "tests"
  ]
}
